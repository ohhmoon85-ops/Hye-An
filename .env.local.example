# ─── Supabase ────────────────────────────────────────────────────────
# 대시보드 > Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ★ 서버 코드에서만 사용한다. 클라이언트 번들에 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 첨부 파일 private 버킷 이름
SUPABASE_STORAGE_BUCKET=documents

# ─── 사이트 ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hyean.kr

# 1단계(발행 기반) 한정 스위치.
# true 이면 발행된 A·B 등급 문건의 본문을 로그인 없이 전부 공개한다.
# 2단계(과금) 진입 시 false 로 바꾸면 페이월이 활성화된다.
HYEAN_FREE_ALL=true
